# Instagram handle (without @). Used by scripts/auth_login.py to name the
# session file as <session_dir>/<handle>_instagram_state.json.
INSTAGRAM_USERNAME=

# Optional: explicit path to the Playwright storage_state JSON. If unset, the
# MCP server looks under INSTAGRAM_SESSION_DIR (default
# ~/.instagram-mcp/sessions/) and falls back to the legacy ./sessions/ folder
# for backward compatibility.
# INSTAGRAM_SESSION_FILE=~/.instagram-mcp/sessions/yourhandle_instagram_state.json

# Optional: directory holding storage_state JSON files. Defaults to
# ~/.instagram-mcp/sessions/.
# INSTAGRAM_SESSION_DIR=~/.instagram-mcp/sessions

# Optional: how long the headless Chromium can sit idle (in seconds) before
# the MCP server tears it down to free RAM. Re-launches on next tool call.
# Default 180.
# BROWSER_IDLE_TIMEOUT_S=180

# Optional: set to "false" to launch Chromium headed (more resistant to
# Instagram's automation detection, but pops a window on every call).
# Defaults to true (headless).
# BROWSER_HEADLESS=true

# Optional: locale and timezone reported to instagram.com by the browser
# context. Defaults are neutral (en-US / Etc/UTC); set these to match the
# account's real region for a less detectable fingerprint.
# BROWSER_LOCALE=en-US
# BROWSER_TIMEZONE_ID=Etc/UTC

# Optional: directory where the download_media tool writes fetched media.
# Defaults to ~/.instagram-mcp/downloads/. The social-ingest pipeline points
# this at the Obsidian vault's media/ folder.
# INSTAGRAM_DOWNLOADS_DIR=~/.instagram-mcp/downloads
