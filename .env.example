# Instagram handle (without @). Used by scripts/auth_login.py to name the
# session file as <session_dir>/<handle>_instagram_state.json. Also a legacy
# alias of the default account when that handle has a session.
INSTAGRAM_USERNAME=

# Optional: the account tools use when they get no `account` argument. Must
# have a session file (a wrong value is an error). Needed when several
# accounts are logged in; with a single session that one is the default.
# INSTAGRAM_DEFAULT_ACCOUNT=yourhandle

# Optional: one more session file outside the session directory. It is added
# as an account and becomes the default unless INSTAGRAM_DEFAULT_ACCOUNT says
# otherwise. Every <handle>_instagram_state.json under INSTAGRAM_SESSION_DIR
# (default ~/.instagram-mcp/sessions/, then the legacy ./sessions/) is an
# account too.
# INSTAGRAM_SESSION_FILE=~/.instagram-mcp/sessions/yourhandle_instagram_state.json

# Optional: directory holding storage_state JSON files. Defaults to
# ~/.instagram-mcp/sessions/.
# INSTAGRAM_SESSION_DIR=~/.instagram-mcp/sessions

# Optional: how long the headless Chromium can sit idle (in seconds) before
# the MCP server tears it down to free RAM. Re-launches on next tool call.
# Default 180.
# BROWSER_IDLE_TIMEOUT_S=180

# Optional: set to "false" to launch Chromium headed (more resistant to
# Instagram's automation detection, but pops a window on every call).
# Defaults to true (headless).
# BROWSER_HEADLESS=true

# Optional: locale and timezone reported to instagram.com by the browser
# context. Defaults are neutral (en-US / Etc/UTC); set these to match the
# account's real region for a less detectable fingerprint.
# BROWSER_LOCALE=en-US
# BROWSER_TIMEZONE_ID=Etc/UTC

# Optional: root where the download_media tool writes fetched media, as
# <root>/<account>/post_<shortcode>_<pk>_<NN>.<ext>.
# Defaults to ~/.instagram-mcp/downloads/. If you point this at an Obsidian
# vault's media/ folder, files now land in a per-account subfolder.
# INSTAGRAM_DOWNLOADS_DIR=~/.instagram-mcp/downloads

# Optional: persistent state (per-account block state and request budget, the
# cross-process lock nav.lock, cached user ids). Defaults to
# ~/.instagram-mcp/state/. Inspect or clear it with
# python -m scripts.account_state [<handle>] [--clear <handle>].
# INSTAGRAM_STATE_DIR=~/.instagram-mcp/state

# Optional: "false" lets instagram.com's scripts run in the fixed tab
# (fallback mode: more RAM, not measured). Defaults to true (scripts blocked).
# INSTAGRAM_BLOCK_JS=true

# Optional: Playwright browser channel, e.g. "chromium" for the new headless.
# BROWSER_CHANNEL=

# Optional: server log level (logs go to stderr). Default WARNING.
# INSTAGRAM_LOG_LEVEL=WARNING

# Optional: request budget per account (sliding windows, persisted). Going over
# raises BudgetExceededError; 0 disables that window. Defaults 150 / 800.
# INSTAGRAM_MAX_REQUESTS_PER_HOUR=150
# INSTAGRAM_MAX_REQUESTS_PER_DAY=800
