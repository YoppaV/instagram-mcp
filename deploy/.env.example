# Values for deploy/docker-compose.yml. Copy to .env next to the compose file.
# No secret goes here: the bearer token lives in secrets/instagram_mcp_token.

# uid/gid that owns the data folders on the NAS (ssh nas 'id -u; id -g').
PUID=1000
PGID=1000

# Host headers clients will send, comma-separated, with port or ":*".
# LAN IP, the NAS hostname and its Tailscale MagicDNS name / 100.x IP.
INSTAGRAM_MCP_ALLOWED_HOSTS=192.168.1.48:*,nas:*,nas.your-tailnet.ts.net:*

# Port on the NAS (container listens on 8000).
INSTAGRAM_MCP_PUBLISHED_PORT=8765

# Optional: required when more than one session file is present.
# INSTAGRAM_DEFAULT_ACCOUNT=yourhandle

# Where the repo is checked out on the NAS, and the live data root.
# INSTAGRAM_MCP_REPO=/volume2/SSD-Proyectos/Instagram-MCP/repo
# INSTAGRAM_MCP_DATA=/volume2/SSD-Proyectos/Instagram-MCP
# INSTAGRAM_MCP_IMAGE_TAG=0.1.0
# INSTAGRAM_LOG_LEVEL=WARNING
